# Modelo das variáveis de ambiente do Na Conta.
# Copie para .env.local e preencha. NUNCA envie o .env.local para o GitHub.
# Os valores reais ficam só nos cofres da Vercel e do GitHub (Settings > Secrets).

# Etapa 2 — Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Etapa 3 — e-mail (Resend) e resumos automáticos (Claude)
RESEND_API_KEY=
ANTHROPIC_API_KEY=

# Etapa 4 — Portal da Transparência (token pessoal gov.br)
PORTAL_TRANSPARENCIA_TOKEN=
